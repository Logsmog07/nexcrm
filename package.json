{
  "name": "crm-project",
  "version": "1.0.0",
  "description": "CRM Analytics & Sales Intelligence System",
  "main": "backend/index.js",
  "scripts": {
    "server": "node backend/index.js",
    "server:dev": "node --watch backend/index.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently --kill-others-on-fail \"npm run server:dev\" \"npm run client\"",
    "client:build": "npm run build --prefix frontend",
    "qa:preflight": "node backend/scripts/qa-preflight.js",
    "qa:lint": "npm run lint --prefix frontend",
    "qa:build": "npm run build --prefix frontend",
    "qa:backend:check": "find backend -name '*.js' -print0 | xargs -0 -n1 node --check",
    "qa:e2e": "npx playwright test --reporter=line",
    "qa:api": "node backend/scripts/qa-api-smoke.js",
    "qa:full": "npm run qa:preflight && npm run qa:lint && npm run qa:build && npm run qa:backend:check && npm run qa:e2e && npm run qa:api",
    "audit:prune": "node backend/scripts/prune-audit-logs.js",
    "test": "echo \"No automated tests configured yet\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "pptxgenjs": "^4.0.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright": "^1.52.0"
  }
}
