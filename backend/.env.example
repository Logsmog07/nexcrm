PORT=3001
CLIENT_URL=http://localhost:5174
CLIENT_URLS=http://localhost:5174,http://127.0.0.1:5174
JWT_SECRET=super-secret-jwt-key
JWT_EXPIRES_IN=7d
JSON_LIMIT=1mb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUDIT_LOG_RETENTION_DAYS=365

DEV_CONSOLE_ENABLED=true
DEV_CONSOLE_PASSWORD=change-this-master-access-key
DEV_JWT_SECRET=change-this-dev-console-jwt-secret
DEV_JWT_EXPIRES_IN=2h
DEV_AUTH_RATE_LIMIT_WINDOW_MS=900000
DEV_AUTH_RATE_LIMIT_MAX=5

DEVELOPER_PORTAL_ENABLED=false
DEVELOPER_PORTAL_EMAIL=
DEVELOPER_PORTAL_PASSWORD=
DEVELOPER_PORTAL_NAME=Developer Console
DEVELOPER_PORTAL_DEFAULT_PREVIEW_ROWS=40
DEVELOPER_PORTAL_MAX_PREVIEW_ROWS=200

DB_USER=postgres
DB_HOST=localhost
DB_NAME=crm_db
DB_PASSWORD=postgres
DB_PORT=5432
DB_SSL=false

# Production (Supabase/Vercel): prefer a single connection string.
